# Production overlay. Pass this after sdkconfig.defaults through
# SDKCONFIG_DEFAULTS. Every security/recovery boundary is explicit so the
# release result does not depend on a developer's cached sdkconfig.
CONFIG_IDF_TARGET="esp32s3"

# CONFIG_CODEX_DEVELOPMENT_HIL is not set

# Keep owner recovery unrestricted. These options must never be enabled by a
# production overlay or by a cached development configuration.
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set
# CONFIG_SECURE_DISABLE_ROM_DL_MODE is not set
# CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE is not set

# CH343/UART0 remains the bounded recovery log path. Native USB stays dedicated
# to Codex, configuration, and update traffic.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Release logs retain warnings and errors without shipping development-level
# traces or an interactive debugger.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LOG_MAXIMUM_LEVEL=2
# CONFIG_ESP_SYSTEM_PANIC_GDBSTUB is not set
# CONFIG_ESP_SYSTEM_GDBSTUB_RUNTIME is not set
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y

CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BT_GATTS_ROBUST_CACHING_ENABLED=y
